module GameEngineCpp {
    // Core platform types and APIs
    // Note: PlatformAPI.h excluded from module to prevent circular dependency during bridging header compilation
    // It will be included directly in the bridging header instead
    
    // Core engine subsystems
    header "ResourceManager.h"
    header "AudioManager.h"
    header "AudioStateManager.h"
    
    // Rendering engine (C++ components only)
    header "Sprite.h"
    header "TextureAtlas.h"
    header "TextureCache.h"
    
    // Audio engine
    header "SoundManager.h"
    header "AudioClip.h"
    header "SoundEffect.h"
    
    // UI and coordinate system (platform-agnostic)
    header "UIManager.h"
    // Note: UICoordinateSystem now uses direct Swift 5.9+ C++ interop via GameEngine-Swift.h
    
    // Game framework components (game-agnostic)
    header "Level.h"
    header "LevelManager.h"
    header "Enemy.h"
    header "Obstacle.h"
    header "PickUp.h"
    header "Projectile.h"
    
    // Export all imported headers
    export *
}
