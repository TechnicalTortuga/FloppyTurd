//
//  CppInteropBridgeSwift.swift
//  Professional Game Engine - Swift C++ Interop Bridge
//
//  Thread-safe bridge between C++ and Swift with proper concurrency handling
//  Uses Swift 6.0 native C++ interoperability with nonisolated functions
//  SOLUTION: nonisolated functions can be called from C++ without actor isolation issues
//

import Foundation
// Only import UIKit if available (iOS)
#if canImport(UIKit)
import UIKit
#endif
import Metal
import MetalKit
import AVFoundation

// MARK: - Global Instance for C++ Access
/// Global instance accessible from C++ - Since top-level functions and static methods 
/// have issues with Swift-to-C++ interop, we expose the shared instance as a global variable
public let cppInteropBridge = CppInteropBridge.shared

// MARK: - Global Access Functions (C++ Compatible)
/// Get the shared CppInteropBridge instance - Top-level function for C++ compatibility
/// Static methods are not supported in Swift-to-C++ interop, so we use a top-level function
/// This MUST be defined before the class to ensure it's treated as a global function
public func getCppInteropBridge() -> CppInteropBridge {
    return CppInteropBridge.shared
}

// MARK: - Swift C++ Interop Bridge (Swift 6.0 Native with nonisolated)
/// This class bridges C++ calls to Swift while maintaining concurrency safety
/// All nonisolated public functions are automatically exposed to C++ via Swift 6.0 C++ interoperability
/// nonisolated functions are safe to call from C++ and use DispatchQueue.main.sync for main thread access
/// Sendable conformance ensures the singleton is safe for concurrent access
public final class CppInteropBridge: Sendable {
    
    // MARK: - Singleton for C++ Access
    public static let shared = CppInteropBridge()
    
    private init() {}

    
    // MARK: - Platform Management (C++ Callable - nonisolated)
    
    /// Initialize platform systems - callable from C++ (nonisolated = safe for C++ interop)
    nonisolated public func initializePlatform() -> Bool {
        // nonisolated functions can use DispatchQueue.main.sync to safely access main thread
        var result = false
        DispatchQueue.main.sync {
            // Since GameEngine.initialize requires parameters, we'll just return success
            // In a real implementation, these would be passed from C++
            result = true
        }
        return result
    }
    
    /// Shutdown platform systems - callable from C++ (nonisolated = safe for C++ interop)
    nonisolated public func shutdownPlatform() {
        DispatchQueue.main.sync {
            GameEngine.shutdown()
        }
    }
    
    /// Initialize game engine - callable from C++ (nonisolated = safe for C++ interop)
    nonisolated public func initializeEngine() -> Bool {
        var result = false
        DispatchQueue.main.sync {
            // Engine initialization requires specific parameters
            // For now, just return success - real implementation would setup with C++ provided params
            result = true
        }
        return result
    }
    
    /// Shutdown game engine - callable from C++ (nonisolated = safe for C++ interop)
    nonisolated public func shutdownEngine() {
        DispatchQueue.main.sync {
            GameEngine.shutdown()
        }
    }
    
    // MARK: - Window Management (C++ Callable - nonisolated)
    
    /// Initialize window - callable from C++ (nonisolated = safe for C++ interop)
    nonisolated public func initWindow() -> Bool {
        var result = false
        DispatchQueue.main.sync {
            // Window operations need main thread
            result = true // iOS windows are managed by the system
        }
        return result
    }
    
    /// Close window - callable from C++ (nonisolated = safe for C++ interop)
    nonisolated public func closeWindow() {
        DispatchQueue.main.sync {
            // iOS apps don't typically close windows
        }
    }
    
    /// Check if window should close - callable from C++ (nonisolated = safe for C++ interop)
    nonisolated public func windowShouldClose() -> Bool {
        var result = false
        DispatchQueue.main.sync {
            result = false // iOS apps don't close windows
        }
        return result
    }
    
