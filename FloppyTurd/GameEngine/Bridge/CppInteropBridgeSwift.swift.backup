    /// Get resource path - callable from C++
    public func getResourcePath(_ resourceName: String) -> String {
        guard let bundlePath = Bundle.main.path(forResource: resourceName, ofType: nil) else {
            return resourceName
        }
        return bundlePath
    }
    
    /// Get save data path - callable from C++
    public func getSaveDataPath(_ filename: String) -> String {
        let documentsPath = NSSearchPathForDirectoriesInDomains(.documentDirectory, .userDomainMask, true)[0]
        return documentsPath + "/" + filename
    }
    
    /// Check if mobile platform - callable from C++
    public func isMobilePlatform() -> Bool {
        return true // Always true on iOS
