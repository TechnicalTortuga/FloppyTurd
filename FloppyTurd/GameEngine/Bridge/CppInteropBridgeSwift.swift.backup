    // MARK: - Font Functions (C++ Callable)
    
    /// Load font - callable from C++
    public func loadFont(_ fileName: String) -> Int32 {
        var fontId: Int32 = 0
        DispatchQueue.main.sync {
            Task {
                fontId = await FontResourceManager.shared.createFont(name: fileName, size: 18.0)
            }
        }
        return fontId
    }
    
    /// Load font with parameters - callable from C++
    public func loadFontEx(_ fileName: String, _ fontSize: Int32, _ fontCharsPtr: UnsafePointer<Int32>?, _ glyphCount: Int32) -> Int32 {
        var fontId: Int32 = 0
        DispatchQueue.main.sync {
            Task {
                fontId = await FontResourceManager.shared.createFont(name: fileName, size: CGFloat(fontSize))
            }
        }
        return fontId
    }
    
    /// Unload font - callable from C++
    public func unloadFont(_ fontId: Int32) {
        Task {
            await FontResourceManager.shared.removeFont(id: fontId)
        }
    }
    
    /// Measure text - callable from C++
    public func measureText(_ text: String, _ fontSize: Int32) -> Int32 {
        var width: Int32 = 0
        DispatchQueue.main.sync {
            // Measure text width
            width = Int32(text.count * Int(fontSize) / 2) // Rough approximation
        }
        return width
    }
    
    /// Measure text with font - callable from C++
    nonisolated public func measureTextEx(_ fontId: Int32, _ text: String, _ fontSize: Float, _ spacing: Float) -> (Float, Float) {
        var size: (Float, Float) = (0, 0)
        DispatchQueue.main.sync {
            // Measure text with font
            size = (Float(text.count) * fontSize * 0.6, fontSize) // Rough approximation
        }
        return size
    }
    
    /// Measure text width - callable from C++ (workaround for tuple interop)
    nonisolated public func measureTextExWidth(_ fontId: Int32, _ text: String, _ fontSize: Float, _ spacing: Float) -> Float {
        return Float(text.count) * fontSize * 0.6 // Rough approximation
    }
    
    /// Measure text height - callable from C++ (workaround for tuple interop)
    nonisolated public func measureTextExHeight(_ fontId: Int32, _ text: String, _ fontSize: Float, _ spacing: Float) -> Float {
        return fontSize
    }
    
