    // MARK: - Vector Math Functions (C++ Callable)
    
    /// Vector2 length - callable from C++
    public func vector2Length(_ x: Float, _ y: Float) -> Float {
        return sqrt(x * x + y * y)
    }
    
    /// Vector2 normalize - callable from C++
    nonisolated public func vector2Normalize(_ x: Float, _ y: Float) -> (Float, Float) {
        let length = sqrt(x * x + y * y)
        if length == 0 { return (0, 0) }
        return (x / length, y / length)
    }
    
    /// Vector2 normalize X component - callable from C++ (workaround for tuple interop)
    nonisolated public func vector2NormalizeX(_ x: Float, _ y: Float) -> Float {
        let length = sqrt(x * x + y * y)
        if length == 0 { return 0 }
        return x / length
    }
    
    /// Vector2 normalize Y component - callable from C++ (workaround for tuple interop)
    nonisolated public func vector2NormalizeY(_ x: Float, _ y: Float) -> Float {
        let length = sqrt(x * x + y * y)
        if length == 0 { return 0 }
        return y / length
    }
    
    /// Vector2 add - callable from C++
    nonisolated public func vector2Add(_ x1: Float, _ y1: Float, _ x2: Float, _ y2: Float) -> (Float, Float) {
        return (x1 + x2, y1 + y2)
    }
    
    /// Vector2 add X component - callable from C++ (workaround for tuple interop)
    nonisolated public func vector2AddX(_ x1: Float, _ y1: Float, _ x2: Float, _ y2: Float) -> Float {
        return x1 + x2
    }
    
    /// Vector2 add Y component - callable from C++ (workaround for tuple interop)
    nonisolated public func vector2AddY(_ x1: Float, _ y1: Float, _ x2: Float, _ y2: Float) -> Float {
        return y1 + y2
    }
    
    /// Vector2 subtract - callable from C++
    nonisolated public func vector2Subtract(_ x1: Float, _ y1: Float, _ x2: Float, _ y2: Float) -> (Float, Float) {
        return (x1 - x2, y1 - y2)
    }
    
    /// Vector2 subtract X component - callable from C++ (workaround for tuple interop)
    nonisolated public func vector2SubtractX(_ x1: Float, _ y1: Float, _ x2: Float, _ y2: Float) -> Float {
        return x1 - x2
    }
    
    /// Vector2 subtract Y component - callable from C++ (workaround for tuple interop)
    nonisolated public func vector2SubtractY(_ x1: Float, _ y1: Float, _ x2: Float, _ y2: Float) -> Float {
        return y1 - y2
    }
    
    /// Vector2 scale - callable from C++
    nonisolated public func vector2Scale(_ x: Float, _ y: Float, _ scale: Float) -> (Float, Float) {
        return (x * scale, y * scale)
    }
    
    /// Vector2 scale X component - callable from C++ (workaround for tuple interop)
    nonisolated public func vector2ScaleX(_ x: Float, _ y: Float, _ scale: Float) -> Float {
        return x * scale
    }
    
    /// Vector2 scale Y component - callable from C++ (workaround for tuple interop)
    nonisolated public func vector2ScaleY(_ x: Float, _ y: Float, _ scale: Float) -> Float {
        return y * scale
    }
    
    /// Vector2 distance - callable from C++
    public func vector2Distance(_ x1: Float, _ y1: Float, _ x2: Float, _ y2: Float) -> Float {
        let dx = x2 - x1
        let dy = y2 - y1
        return sqrt(dx * dx + dy * dy)
    }
    
    // MARK: - Collision Detection Functions (C++ Callable)
    
    /// Check collision between rectangles - callable from C++
    public func checkCollisionRecs(_ x1: Float, _ y1: Float, _ width1: Float, _ height1: Float, _ x2: Float, _ y2: Float, _ width2: Float, _ height2: Float) -> Bool {
        return (x1 < x2 + width2 && x1 + width1 > x2 && y1 < y2 + height2 && y1 + height1 > y2)
    }
    
    /// Check collision between circle and rectangle - callable from C++
    public func checkCollisionCircleRec(_ centerX: Float, _ centerY: Float, _ radius: Float, _ x: Float, _ y: Float, _ width: Float, _ height: Float) -> Bool {
        let closestX = max(x, min(centerX, x + width))
        let closestY = max(y, min(centerY, y + height))
        let distanceX = centerX - closestX
        let distanceY = centerY - closestY
        return (distanceX * distanceX + distanceY * distanceY) <= (radius * radius)
    }
    
    /// Check collision between point and rectangle - callable from C++
    public func checkCollisionPointRec(_ pointX: Float, _ pointY: Float, _ x: Float, _ y: Float, _ width: Float, _ height: Float) -> Bool {
        return (pointX >= x && pointX <= x + width && pointY >= y && pointY <= y + height)
    }
    
    // MARK: - Color Functions (C++ Callable)
    
    /// Color with alpha - callable from C++
    nonisolated public func colorAlpha(_ red: Float, _ green: Float, _ blue: Float, _ originalAlpha: Float, _ alpha: Float) -> RaylibColor {
        return RaylibColor(r: UInt8(red * 255), g: UInt8(green * 255), b: UInt8(blue * 255), a: UInt8(alpha * 255))
    }
    
    /// Fade color - callable from C++
    nonisolated public func fade(_ red: Float, _ green: Float, _ blue: Float, _ originalAlpha: Float, _ alpha: Float) -> RaylibColor {
        return RaylibColor(r: UInt8(red * 255), g: UInt8(green * 255), b: UInt8(blue * 255), a: UInt8(alpha * 255))
    }
    
    /// Color lerp - callable from C++
    nonisolated public func colorLerp(_ r1: Float, _ g1: Float, _ b1: Float, _ a1: Float, _ r2: Float, _ g2: Float, _ b2: Float, _ a2: Float, _ amount: Float) -> RaylibColor {
        let r = r1 + (r2 - r1) * amount
        let g = g1 + (g2 - g1) * amount
        let b = b1 + (b2 - b1) * amount
        let a = a1 + (a2 - a1) * amount
        return RaylibColor(r: UInt8(r * 255), g: UInt8(g * 255), b: UInt8(b * 255), a: UInt8(a * 255))
    }
    
    /// Create new rectangle - callable from C++
    nonisolated public func rectangleNew(_ x: Float, _ y: Float, _ width: Float, _ height: Float) -> Rectangle {
        return Rectangle(x: x, y: y, width: width, height: height)
    }
    
    // MARK: - Math Utility Functions (C++ Callable)
    
    /// Clamp value - callable from C++
    public func clamp(_ value: Float, _ min: Float, _ max: Float) -> Float {
        return Swift.max(min, Swift.min(value, max))
    }
    
    /// Lerp - callable from C++
    public func lerp(_ start: Float, _ end: Float, _ amount: Float) -> Float {
        return start + (end - start) * amount
    }
    
